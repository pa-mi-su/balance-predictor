{
  "info": {
    "name": "Balance Predictor — Full E2E (Opaque Token, All Routes)",
    "_postman_id": "1c8b2c0c-0b2a-4d39-9d42-0f1f0f1ee001",
    "description": "Phase A: assert 401/403 without token on protected endpoints. Phase B: login to capture opaque token (body + X-Auth-Token header). Phase C: run full authorized E2E. Phase D: logout and confirm unauthorized again.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8081" },

    { "key": "username", "value": "testuser" },
    { "key": "email", "value": "testuser@example.com" },
    { "key": "password", "value": "P@ssw0rd!123" },

    { "key": "userId", "value": "1" },

    { "key": "opaque_token", "value": "" },
    { "key": "plaid_public_token", "value": "" },
    { "key": "plaid_account_id", "value": "" }
  ],
  "item": [
    {
      "name": "A) WITHOUT TOKEN — expect 401/403",
      "item": [
