            ]}}
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/plaid/sandbox/public_token/create",
            "body": { "mode": "raw", "raw": "{\n  \"userId\": {{userId}}\n}" }
          }
        },
        {
          "name": "Plaid: POST /api/plaid/item/public_token/exchange (no token)",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
