          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/ledger/events?userId={{userId}}",
            "body": { "mode": "raw", "raw": "[]" }
          }
        },
        {
          "name": "Plaid: POST /api/plaid/link/token/create (no token)",
          "event": [
