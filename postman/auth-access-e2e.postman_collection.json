          "name": "Plaid: GET /api/plaid/balance (no token)",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test('401/403 expected', function(){ pm.expect(pm.response.code).to.be.oneOf([401,403]); });"
            ]}}
          ],
          "request": { "method": "GET", "header": [], "url": "{{base_url}}/api/plaid/balance?userId={{userId}}" }
        },
        {
          "name": "Plaid: GET /api/plaid/balance/{accountId} (no token)",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test('401/403 expected', function(){ pm.expect(pm.response.code).to.be.oneOf([401,403]); });"
            ]}}
          ],
          "request": { "method": "GET", "header": [], "url": "{{base_url}}/api/plaid/balance/{{plaid_account_id}}?userId={{userId}}" }
