{
  "info": {
    "name": "Balance Predictor – Auth Access Test (Pre/Post Login)",
    "_postman_id": "99999999-8888-7777-6666-555555555555",
    "description": "Verifies that only /api/auth endpoints are public while all others are blocked (403) before and after login. Works with current WebSecurityConfig (denyAll).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "gateway_base", "value": "http://localhost:8081" },
    { "key": "username", "value": "testuser" },
    { "key": "email", "value": "testuser@example.com" },
    { "key": "password", "value": "password123" },
    { "key": "userId", "value": "1" },
    { "key": "bearer_token", "value": "" }
  ],
  "item": [
    {
      "name": "A) Before Login (open endpoints)",
      "item": [
        {
          "name": "Auth Health",
          "request": {
            "method": "GET",
            "url": "{{gateway_base}}/api/auth/health"
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });"
            ] }
          }]
        },
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{gateway_base}}/api/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{ \"username\": \"{{username}}\", \"email\": \"{{email}}\", \"password\": \"{{password}}\" }"
            }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('Status 200 or 201', function () { pm.expect([200,201]).to.include(pm.response.code); });"
            ] }
          }]
        },
        {
          "name": "Login (no token yet)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{gateway_base}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{ \"username\": \"{{username}}\", \"password\": \"{{password}}\" }"
            }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Contains message', function () { pm.expect(pm.response.text()).to.include('Login successful'); });"
            ] }
          }]
        }
      ]
    },
    {
      "name": "B) Protected Routes (expect 403)",
      "item": [
        {
          "name": "Auth Secret (should be blocked)",
          "request": { "method": "GET", "url": "{{gateway_base}}/api/auth/secret" },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('Status 403', function () { pm.response.to.have.status(403); });"
            ] }
          }]
        },
        {
          "name": "Plaid Balance (should be blocked)",
          "request": { "method": "GET", "url": "{{gateway_base}}/api/plaid/balance?userId={{userId}}" },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('Status 403', function () { pm.response.to.have.status(403); });"
            ] }
          }]
        },
        {
          "name": "Ledger Events (should be blocked)",
          "request": { "method": "GET", "url": "{{gateway_base}}/api/ledger/events?userId={{userId}}" },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('Status 403', function () { pm.response.to.have.status(403); });"
            ] }
          }]
        },
        {
          "name": "Balance Running (should be blocked)",
          "request": { "method": "GET", "url": "{{gateway_base}}/api/balance/running?userId={{userId}}" },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('Status 403', function () { pm.response.to.have.status(403); });"
            ] }
          }]
        }
      ]
    },
    {
      "name": "C) After Logout (same as before)",
      "item": [
        {
          "name": "Logout (optional endpoint)",
          "request": { "method": "POST", "url": "{{gateway_base}}/api/auth/logout" },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('Status 200 or 404 (if not implemented)', function () { pm.expect([200,404]).to.include(pm.response.code); });"
            ] }
          }]
        },
        {
          "name": "Check Health after logout",
          "request": { "method": "GET", "url": "{{gateway_base}}/api/auth/health" },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('Still 200', function () { pm.response.to.have.status(200); });"
            ] }
          }]
        }
      ]
    }
  ]
}
