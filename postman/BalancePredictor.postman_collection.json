{
  "info": {
    "name": "Balance Predictor (via API Gateway)",
    "_postman_id": "b74a6d3a-3e64-4d2f-9c9b-collection-gateway",
    "description": "Postman collection for Balance Predictor routed through Spring Cloud Gateway. Includes Eureka health and direct service checks through the gateway discovery locator.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Eureka health",
          "request": { "method": "GET", "header": [], "url": "{{eureka_base}}/actuator/health" },
          "response": []
        },
        {
          "name": "Gateway health",
          "request": { "method": "GET", "header": [], "url": "{{gateway_base}}/actuator/health" },
          "response": []
        },
        {
          "name": "Balance health (via gateway discovery)",
          "request": { "method": "GET", "header": [], "url": "{{gateway_base}}/balance-service/actuator/health" },
          "response": []
        },
        {
          "name": "Ledger health (via gateway discovery)",
          "request": { "method": "GET", "header": [], "url": "{{gateway_base}}/ledger-service/actuator/health" },
          "response": []
        },
        {
          "name": "Plaid health (via gateway discovery)",
          "request": { "method": "GET", "header": [], "url": "{{gateway_base}}/plaid-service/actuator/health" },
          "response": []
        }
      ]
    },
    {
      "name": "Ledger Service (via gateway)",
      "item": [
        {
          "name": "Add events (POST)",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "url": {
              "raw": "{{gateway_base}}/api/ledger/events?userId={{userId}}",
              "host": [ "{{gateway_base}}" ],
              "path": [ "api", "ledger", "events" ],
              "query": [ { "key": "userId", "value": "{{userId}}" } ]
            },
            "body": {
              "mode": "raw",
              "raw": "[\n  {\n    \"date\": \"2025-10-04\",\n    \"amount\": -50.0,\n    \"description\": \"Test debit\"\n  },\n  {\n    \"date\": \"2025-10-04\",\n    \"amount\": 200.0,\n    \"description\": \"Paycheck\"\n  }\n]"
            },
            "description": "Negative = debit (money out). Positive = credit (money in)."
          },
          "response": []
        },
        {
          "name": "Get events (GET)",
          "request": { "method": "GET", "header": [], "url": "{{gateway_base}}/api/ledger/events?userId={{userId}}" },
          "response": []
        }
      ]
    },
    {
      "name": "Plaid Service (mock, via gateway)",
      "item": [
        {
          "name": "Get current balance",
          "request": { "method": "GET", "header": [], "url": "{{gateway_base}}/api/plaid/balance?userId={{userId}}" },
          "response": []
        }
      ]
    },
    {
      "name": "Balance Service (aggregated, via gateway)",
      "item": [
        {
          "name": "Get projected balance",
          "request": { "method": "GET", "header": [], "url": "{{gateway_base}}/api/balance/running?userId={{userId}}" },
          "response": []
        }
      ]
    },
    {
      "name": "Direct Services (optional)",
      "item": [
        { "name": "Balance direct health", "request": { "method": "GET", "header": [], "url": "http://localhost:8080/actuator/health" }, "response": [] },
        { "name": "Ledger direct health", "request": { "method": "GET", "header": [], "url": "http://localhost:8082/actuator/health" }, "response": [] },
        { "name": "Plaid direct health", "request": { "method": "GET", "header": [], "url": "http://localhost:8083/actuator/health" }, "response": [] }
      ]
    }
  ],
  "variable": [
    { "key": "userId", "value": "1" },
    { "key": "eureka_base", "value": "http://localhost:8761" },
    { "key": "gateway_base", "value": "http://localhost:8081" }
  ]
}
